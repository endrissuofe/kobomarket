# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Databases ---
# Option A: docker compose (default). Hostnames are the compose service names.
MONGO_URI=mongodb://mongo:27017/kobomarket
DATABASE_URL=postgres://kobo:kobo@postgres:5432/kobomarket
REDIS_URL=redis://redis:6379

# Option B: running Node directly on your machine (no Docker).
# Comment out Option A and use either local services:
#   MONGO_URI=mongodb://localhost:27017/kobomarket
#   DATABASE_URL=postgres://kobo:kobo@localhost:5432/kobomarket
#   REDIS_URL=redis://localhost:6379
# or free cloud services (paste the connection strings they give you):
#   MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kobomarket   # MongoDB Atlas
#   DATABASE_URL=postgres://<user>:<password>@<host>/kobomarket?sslmode=require  # Neon or Supabase
#   REDIS_URL=rediss://default:<password>@<host>:6379                            # Upstash

# --- Auth (replace with long random strings) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Paystack (test mode keys only) ---
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# --- Business defaults (admin can change commission at runtime) ---
DEFAULT_COMMISSION_BPS=500
ESCROW_TIMEOUT_HOURS=72
PAYOUT_MIN_KOBO=100000
