# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# --- Databases ---
# Inside docker compose these hostnames are the service names
MONGO_URI=mongodb://mongo:27017/kobomarket
DATABASE_URL=postgres://kobo:kobo@postgres:5432/kobomarket
REDIS_URL=redis://redis:6379

# --- Auth (replace with long random strings) ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Paystack (test mode keys only) ---
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment/callback

# --- Business defaults (admin can change commission at runtime) ---
DEFAULT_COMMISSION_BPS=500
ESCROW_TIMEOUT_HOURS=72
PAYOUT_MIN_KOBO=100000
